GOOGLE_API_KEY=your_google_ai_studio_key
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TEMPERATURE=0
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
# Docker: http://localhost:6333  |  Cloud: https://xxxx.cloud.qdrant.io:6333
# Leave QDRANT_URL empty to use local on-disk store at QDRANT_PATH.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_PATH=./data/qdrant
QDRANT_COLLECTION=athlyte_docs
DOCS_PATH=../docs
OKF_BUNDLE_PATH=../okf_bundle
TOP_K=8
SCORE_THRESHOLD=0.35
OKF_EXPAND_HOPS=1
RRF_K=60
